# ASTRO SIVAM — environment variables
#
# Copy to `.env` for local development. On cPanel, set these as real environment
# variables (MultiPHP INI / .htaccess SetEnv) — the Node server and the PHP API
# read the same names so both stacks behave identically.

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
# ALLOWED_ORIGINS: Comma-separated browser origins allowed to call the API.
# Defaults to the two production origins.
#
# In development (NODE_ENV != production) localhost, *.e2b.app, *.run.app and
# *.googleusercontent.com are additionally accepted automatically, so you do
# not need to touch this while hacking.
#
# In PRODUCTION only the exact origins listed here are accepted. That is
# deliberate: the API is credentialed, and anyone can register a *.run.app
# hostname within minutes, so a wildcard suffix there would be equivalent to
# Access-Control-Allow-Origin: * with the visitor's token attached.
#
# Deploying to Cloud Run / a preview host? Add that exact origin:
#   ALLOWED_ORIGINS="https://astrosivam.com,https://astrosivam-abc123.run.app"
# The server logs a [CORS] warning at startup if this is unset in production.
ALLOWED_ORIGINS="https://astrosivam.com,https://www.astrosivam.com"

# GOOGLE_CLIENT_ID / FACEBOOK_APP_ID + FACEBOOK_APP_SECRET: optional social
# login credentials (the PHP API verifies the Google/Facebook token server-side).
GOOGLE_CLIENT_ID=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# ASTRO_RAHU_NODE_TYPE: Rahu/Ketu convention used by the PHP AstroEngine.
#   TRUE = osculating (true) lunar node, Swiss Ephemeris / Drik Panchang default.
#   MEAN = mean lunar node. The two can differ by up to ~1°45'.
# Overrides the define('ASTRO_RAHU_NODE_TYPE', ...) in api/config.php. Every
# chart result and /api/services/calculate-preview response reports `nodeType`.
ASTRO_RAHU_NODE_TYPE=TRUE

# ASTRO_AYANAMSA_MODE: Lahiri (Chitra Paksha) ayanamsa convention.
#   TRUE = mean Lahiri + Δψ (IAU 1980 nutation) — Drik Panchang, the PHP
#          AstroEngine and swe_get_ayanamsa_ex_ut(). This is the default.
#   MEAN = mean Lahiri only — matches swe_get_ayanamsa_ut().
# The two differ by up to 18.44" (10.73" RMS), which moves every sidereal
# longitude and the Lagna. Both stacks default to TRUE; every horoscope result
# reports `ayanamsaMode` so a report always states which one produced it.
ASTRO_AYANAMSA_MODE=TRUE

# ---------------------------------------------------------------------------
# Shared rate limiting (multi-instance safety)
# ---------------------------------------------------------------------------
# REDIS_URL: When set (redis:// or rediss://), login lockouts and the API rate
# limits are stored in Redis so every Node instance shares the same counters.
# Leave empty for a single-instance deployment: an in-process limiter is used.
REDIS_URL=

# RATE_LIMIT_BACKEND: Set to `memory` to force in-process limiting even when
# REDIS_URL is configured (useful for local debugging).
RATE_LIMIT_BACKEND=

# REDIS_COMMAND_TIMEOUT_MS: Per-command Redis timeout. A slow/unresponsive
# Redis is treated as an outage instead of stalling every request. Default 2000.
REDIS_COMMAND_TIMEOUT_MS=2000

# RATE_LIMIT_FAIL_MODE: `open` (default) keeps serving requests with the local
# limiter when Redis is unreachable. `closed` refuses the request instead —
# use it only where blocking traffic is preferable to losing a shared counter.
RATE_LIMIT_FAIL_MODE=open

# API_BODY_LIMIT / STAGED_DOC_BODY_LIMIT: JSON and staged-document body limits.
API_BODY_LIMIT=8mb
STAGED_DOC_BODY_LIMIT=56mb

# ---------------------------------------------------------------------------
# Family bundle email attachments
# ---------------------------------------------------------------------------
# FAMILY_EMAIL_MAX_ATTACHMENT_MB: Per-email attachment budget (MIME-encoded).
# A family bundle bigger than this is split across several emails; a single
# document that cannot fit is reported to the admin. Default 18, range 1-200.
FAMILY_EMAIL_MAX_ATTACHMENT_MB=18

# FAMILY_EMAIL_MAX_ATTACHMENT_BYTES: Byte-based override (512 KB - 200 MB).
# FAMILY_EMAIL_MAX_ATTACHMENT_MB wins when both are set.
FAMILY_EMAIL_MAX_ATTACHMENT_BYTES=

# ---------------------------------------------------------------------------
# SMTP (Node server)
# ---------------------------------------------------------------------------
# All four of SMTP_HOST/SMTP_USER/SMTP_PASS/SMTP_PORT must be present or no mail
# is sent (the API then reports `SMTP is not configured`).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Set to `true` for implicit TLS (port 465); STARTTLS is used otherwise.
SMTP_SECURE=false

# ---------------------------------------------------------------------------
# Payments — Razorpay (UPI / Google Pay, INR)
# ---------------------------------------------------------------------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET: HMAC secret configured in the Razorpay dashboard.
# Required to accept `payment.captured` / `order.paid` webhooks; without it every
# webhook is rejected (fail closed) and recovery relies on admin reconciliation.
RAZORPAY_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Payments — PayPal (REST, USD)
# ---------------------------------------------------------------------------
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# PAYPAL_WEBHOOK_ID: Webhook id from the PayPal developer dashboard. Required to
# verify `PAYMENT.CAPTURE.COMPLETED` events through PayPal's verify API; without
# it the webhook endpoint answers 503 and no capture is trusted.
PAYPAL_WEBHOOK_ID=

# ---------------------------------------------------------------------------
# Order alerts (optional)
# ---------------------------------------------------------------------------
# WhatsApp Cloud API — used for best-effort "order completed" alerts.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_NAME=
# Viber Bot — alternative alert channel.
VIBER_AUTH_TOKEN=
VIBER_SENDER_NAME=

# ---------------------------------------------------------------------------
# Contact form
# ---------------------------------------------------------------------------
# CONTACT_INQUIRY_TO: Recipient for contact-form enquiries. Falls back to the
# admin notification email, then the site contact address, then ADMIN_EMAIL.
CONTACT_INQUIRY_TO=

# ---------------------------------------------------------------------------
# PHP API (cPanel)
# ---------------------------------------------------------------------------
# Database credentials used by everything under /api (config.php).
DB_HOST=localhost
DB_NAME=
DB_USER=
DB_PASS=
DB_PORT=3306

# APP_SECRET_KEY: HMAC key for bearer tokens. When empty, a strong key is
# generated once and persisted to api/astrology/tmp/app_secret_key.txt.
APP_SECRET_KEY=

# ASTROSIVAM_DIAGNOSTICS: set to 1 to enable the PHP mPDF/font self-test page
# (/api/check_mpdf.php). Leave empty in production: it prints server paths.
ASTROSIVAM_DIAGNOSTICS=

# ADMIN_EMAIL / SUPPORT_EMAIL: fallback recipients for system mail.
ADMIN_EMAIL=admin@astrosivam.com
SUPPORT_EMAIL=admin@astrosivam.com

# ---------------------------------------------------------------------------
# Local tooling (not needed on the server)
# ---------------------------------------------------------------------------
# ASTROSIVAM_DATA_DIR: directory for the JSON data store (dev/tests only).
ASTROSIVAM_DATA_DIR=

# npm run provision:admin creates the first Node administrator from these.
ASTROSIVAM_ADMIN_EMAIL=
ASTROSIVAM_ADMIN_NAME=
ASTROSIVAM_ADMIN_PASSWORD=
