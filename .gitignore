# Locally generated report previews / verification harness output (repository root)
/tmp/

# PHP runtime directory: the HMAC signing key (api/config.php) and the mPDF font
# cache live here and are never committed. Only the Apache guard that denies all
# HTTP access to the directory is tracked — the runtime gate depends on it
# (tests/full-suite.test.ts) and the deploy scripts copy it to the server.
api/astrology/tmp/*
!api/astrology/tmp/.htaccess

# Node↔PHP parity: regenerable engine output (the committed contract is
# tests/fixtures/node-php-parity-expected.json).
tests/fixtures/parity-node.json
tests/fixtures/parity-php.json
