{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "test": "node scripts/run-tests.mjs",
    "parity:corpus": "tsx scripts/build-parity-corpus.ts",
    "parity:node": "tsx scripts/parity-emit-node.ts",
    "parity:php": "php tests/emit-php-parity.php",
    "parity:compare": "tsx scripts/compare-parity.ts",
    "parity:seed": "npm run parity:corpus && npm run parity:node -- --write-expected",
    "test:pdf": "playwright test",
    "test:php": "php tests/astrology-accuracy-regression.test.php && php tests/preview-pdf-quality.test.php && php tests/muhurtham-reports.test.php && php tests/wedding-matching-report.test.php && php tests/sample-engine-meaning.test.php && php tests/namakaran-page2.test.php && php tests/payment-webhook.test.php && php tests/mailer-guards.test.php && php tests/rate-limit.test.php && php tests/node-php-parity.test.php && php tests/jathagam-summary-parity.test.php && php tests/jathagam-navamsa-page1.test.php",
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --outfile=dist/server.cjs",
    "build:zip": "npm run build && python3 scripts/create_dist_zip.py",
    "start": "NODE_ENV=production node dist/server.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "provision:admin": "tsx scripts/provision-admin.ts"
  },
  "dependencies": {
    "@google/genai": "^2.27.0",
    "@tailwindcss/vite": "^4.1.14",
    "@types/leaflet": "^1.9.22",
    "@vitejs/plugin-react": "^5.2.0",
    "astronomy-engine": "^2.1.19",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.5",
    "express": "^5.2.1",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.556.0",
    "motion": "^14.0.0",
    "msedge-tts": "^2.0.9",
    "nodemailer": "^10.0.14",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-helmet-async": "^3.0.0",
    "recharts": "^3.10.1",
    "tz-lookup": "^6.1.25",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/bcryptjs": "^3.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.0",
    "@types/node": "^22.14.0",
    "@types/nodemailer": "^8.0.1",
    "@types/tz-lookup": "^6.1.2",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
