# ==============================================================================
# ASTRO SIVAM - Production Apache / cPanel / LiteSpeed .htaccess Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Directory Listings & Sensitive Files Security
# ------------------------------------------------------------------------------
<IfModule mod_autoindex.c>
  Options -Indexes
</IfModule>

<IfModule mod_negotiation.c>
  Options -MultiViews
</IfModule>

# Block access to hidden, environment, backup and sensitive source files
# Never expose backend bundles or source maps from a mixed Node/PHP build.
<FilesMatch "(\.(map|cjs|sql|env|log|lock|ini|conf|bak|sh|md|git|key|yml|yaml|htaccess|htpasswd)|composer\.(json|lock)|package\.json|tsconfig\.json)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

# ------------------------------------------------------------------------------
# 2. HTTP Security Headers
# ------------------------------------------------------------------------------
<IfModule mod_headers.c>
  # Enforce HTTPS across domain & subdomains for 1 year
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload" env=HTTPS

  # Protect against clickjacking
  Header always set X-Frame-Options "SAMEORIGIN"

  # Prevent MIME type sniffing
  Header always set X-Content-Type-Options "nosniff"

  # Referrer policy for secure transitions
  Header always set Referrer-Policy "strict-origin-when-cross-origin"

  # Restrict unauthorized browser features
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(self)"

  # Legacy XSS protection for older browsers
  Header always set X-XSS-Protection "1; mode=block"
</IfModule>

# ------------------------------------------------------------------------------
# 3. Rewrite Engine, Canonical HTTPS & Non-WWW Redirection, SPA Fallback
# ------------------------------------------------------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # (a) Force Canonical Non-WWW (e.g. www.astrosivam.com -> astrosivam.com)
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

  # (b) Force HTTP to HTTPS (301 Permanent Redirect)
  RewriteCond %{HTTPS} !on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

  # (c) 301 Redirect retired / legacy services to /services
  RewriteRule ^(eclipse-guide|eclipse|kiraganam)$ /services [R=301,L,NC]

  # (d) Pass backend PHP API requests directly to PHP router (do not rewrite to index.html)
  RewriteRule ^api/ - [L,NC]
  RewriteRule ^api$ - [L,NC]

  # (e) Serve real existing static files directly
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]

  # (f) Serve real existing directories directly (except virtual SPA route collisions)
  RewriteCond %{REQUEST_URI} !^/(admin|admin-portal|dashboard|customer-dashboard|login|register|birth-jathagam|marriage-compatibility|baby-naming|muhurtham|subha-muhurtham|services|about|contact|pricing|team)($|/.*)
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # (g) SPA Fallback: Rewrite all client-side virtual routes to index.html
  # React Router / App handles genuine routes and renders 404 Page Not Found for unknown paths.
  RewriteRule ^ index.html [L,QSA]
</IfModule>

# ------------------------------------------------------------------------------
# 4. MIME Types Configuration
# ------------------------------------------------------------------------------
<IfModule mod_mime.c>
  AddType application/javascript .js .mjs
  AddType text/css .css
  AddType image/svg+xml .svg
  AddType application/json .json
  AddType font/woff .woff
  AddType font/woff2 .woff2
  AddType image/webp .webp
  AddType image/avif .avif
</IfModule>

# ------------------------------------------------------------------------------
# 5. Gzip / Brotli Compression
# ------------------------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/x-javascript application/json application/xml image/svg+xml
</IfModule>

# ------------------------------------------------------------------------------
# 6. Browser Caching
# ------------------------------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"

  # Static Assets (immutable Vite bundles)
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"

  # Dynamic HTML should revalidate
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>
